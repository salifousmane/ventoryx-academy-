modules = ["web", "python-3.12", "nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
DJANGO_DEBUG = "True"
ALLOWED_HOSTS = "localhost,127.0.0.1,0.0.0.0,.replit.dev,.repl.co,.replit.app"
CSRF_TRUSTED_ORIGINS = "https://*.replit.dev,https://*.repl.co,https://*.replit.app"
USE_SQLITE = "True"
SECURE_SSL_REDIRECT = "False"
SESSION_COOKIE_SECURE = "False"
CSRF_COOKIE_SECURE = "False"
OPENAI_API_KEY = ""

[userenv.development]
DJANGO_SECRET_KEY = "ventoryx-dev-secret-key-mm0giouh27k"

[userenv.production]
DJANGO_SECRET_KEY = "ventoryx-dev-secret-key-mm0giouh27k"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "wsgi:application"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 5000
externalPort = 5000
