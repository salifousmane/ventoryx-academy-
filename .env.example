# ============================================================
# DJANGO - CONFIGURATION OBLIGATOIRE
# ============================================================
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-openssl
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,ventoryx-academy.fly.dev
CSRF_TRUSTED_ORIGINS=https://ventoryx-academy.fly.dev

# ============================================================
# BASE DE DONNÉES
# ============================================================
# Fly.io: DATABASE_URL sera auto-configuré (PostgreSQL)
USE_SQLITE=False
DB_NAME=ventoryx
DB_USER=ventoryx
DB_PASSWORD=your-db-password-change-me
DB_HOST=db.internal
DB_PORT=5432

# ============================================================
# REDIS - POUR CELERY & CACHE
# ============================================================
# Fly.io: REDIS_URL sera auto-configuré
REDIS_URL=redis://cache.internal:6379

# ============================================================
# OPENAI - ASSISTANT IA
# ============================================================
# ⚠️  CHANGEZ CETTE CLÉ! (exposée actuellement sur GitHub)
OPENAI_API_KEY=your_openai_api_key_here
# ============================================================
# STRIPE - PAIEMENTS
# ============================================================
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_key_here

# ============================================================
# EMAIL - SENDGRID (ou autre)
# ============================================================
SENDGRID_API_KEY=your-sendgrid-api-key-optional
DEFAULT_FROM_EMAIL=noreply@ventoryx-academy.com
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
EMAIL_PORT=587
EMAIL_USE_TLS=True

# ============================================================
# SÉCURITÉ
# ============================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# ============================================================
# MONITORING & SENTRY
# ============================================================
SENTRY_DSN=your-sentry-dsn-optional

# ============================================================
# VARIABLES DE SEED (Données initiales)
# ============================================================
VENTORYX_DEFAULT_PWD=ChangeMe!2026
